#!/usr/bin/env python3

import argparse
import warnings
from pathlib import Path

import numpy as np
from astropy.io import fits
from astropy.time import Time
from astropy.utils.exceptions import AstropyUserWarning

from hvJP2K.jp2.jp2_encode import COLORMAPS, encode


def image_hdu(hdus, index):
    candidates = hdus if index is None else (hdus[index],)
    for hdu in candidates:
        image = hdu.data
        if image is not None and image.ndim == 2 and image.dtype == np.uint8:
            return hdu

    if index is None:
        raise ValueError("FITS file contains no two-dimensional 8-bit image")
    raise ValueError(f"FITS HDU {index} is not a two-dimensional 8-bit image")


def corrected_header(header, args):
    header = header.copy()
    overrides = {
        "DATE-OBS": args.date_obs,
        "TELESCOP": args.telescop,
        "INSTRUME": args.instrume,
        "DETECTOR": args.detector,
        "WAVELNTH": args.wavelnth,
    }
    for keyword, value in overrides.items():
        if value is not None:
            header[keyword] = value

    if "TELESCOP" not in header and "OBSRVTRY" in header:
        header["TELESCOP"] = header["OBSRVTRY"]
    if "DETECTOR" not in header and "INSTRUME" in header:
        header["DETECTOR"] = header["INSTRUME"]
    return header


def output_path(input_path, header, args):
    directory = Path(args.out_dir) if args.out_dir else Path()
    if args.out_dateobs_dir:
        if "DATE-OBS" not in header:
            raise ValueError("DATE-OBS is required for --out-dateobs-dir")
        observed = Time(header["DATE-OBS"]).to_datetime()
        directory /= f"{observed.year:04d}/{observed.month:02d}/{observed.day:02d}"

    directory.mkdir(parents=True, exist_ok=True)
    basename = input_path.name
    if Path(basename).suffix.lower() in (".bz2", ".fz", ".gz", ".xz", ".z"):
        basename = Path(basename).stem
    return directory / Path(basename).with_suffix(".jp2")


def parse_arguments():
    parser = argparse.ArgumentParser(
        description="Encode a two-dimensional 8-bit FITS image as Helioviewer JP2."
    )
    parser.add_argument("-i", "--input", required=True, metavar="FITS")
    parser.add_argument("--hdu", type=int, help="FITS HDU index")
    parser.add_argument("-o", "--out-dir", metavar="DIRECTORY")
    parser.add_argument(
        "-O",
        "--out-dateobs-dir",
        action="store_true",
        help="write below YYYY/MM/DD derived from DATE-OBS",
    )
    parser.add_argument(
        "-p", "--print-filename", action="store_true", help="print output filename"
    )
    parser.add_argument("-c", "--contact", default="swhv@oma.be")
    parser.add_argument("-C", "--colormap", choices=COLORMAPS)
    parser.add_argument(
        "-N",
        "--no-verify",
        action="store_true",
        help="do not verify FITS checksums",
    )
    parser.add_argument("--date-obs", help="DATE-OBS keyword override")
    parser.add_argument("--telescop", help="TELESCOP keyword override")
    parser.add_argument("--instrume", help="INSTRUME keyword override")
    parser.add_argument("--detector", help="DETECTOR keyword override")
    parser.add_argument("--wavelnth", help="WAVELNTH keyword override")
    parser.add_argument("--cratio", type=float, default=3.3)
    parser.add_argument("--nlayers", type=int, default=4)
    parser.add_argument("--nresolutions", type=int, default=6)
    parser.add_argument("--precinctw", type=int, default=128)
    parser.add_argument("--precincth", type=int, default=128)
    parser.add_argument("-v", "--verbose", action="store_true")
    return parser, parser.parse_args()


def main():
    parser, args = parse_arguments()
    input_path = Path(args.input)

    try:
        with warnings.catch_warnings():
            if not args.no_verify:
                warnings.filterwarnings(
                    "error",
                    message=r".*(?:Checksum|Datasum) verification failed.*",
                    category=AstropyUserWarning,
                )
            with fits.open(
                input_path, memmap=True, checksum=not args.no_verify
            ) as hdus:
                hdu = image_hdu(hdus, args.hdu)
                header = corrected_header(hdu.header, args)
                output = output_path(input_path, header, args)
                encode(
                    hdu.data,
                    header,
                    output,
                    colormap=args.colormap,
                    contact=args.contact,
                    compression_ratio=args.cratio,
                    layers=args.nlayers,
                    resolutions=args.nresolutions,
                    precinct=(args.precincth, args.precinctw),
                    verbose=args.verbose,
                )
    except (AstropyUserWarning, IndexError, OSError, RuntimeError, ValueError) as error:
        parser.error(str(error))

    if args.print_filename:
        print(output)


if __name__ == "__main__":
    main()
