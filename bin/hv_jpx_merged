#!/usr/bin/env python3

import argparse

from hvJP2K.jpx.jpx_merge_daemon import jpx_merge_daemon

parser = argparse.ArgumentParser(
    description='Run the persistent JPX merge service.')
parser.add_argument('--socket', default='/tmp/hv_jpx_merged_socket',
                    help='Unix socket path')
args = parser.parse_args()

try:
    jpx_merge_daemon(args.socket)
except KeyboardInterrupt:
    pass
