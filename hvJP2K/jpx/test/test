#!/bin/sh

set -eu

test_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
work_root=$(mktemp -d "${TMPDIR:-/tmp}/hvjp2k-jpx-test.XXXXXX")
trap 'rm -rf "$work_root"' EXIT

if [ -n "${HVJP2K_BIN:-}" ]; then
    merge="$HVJP2K_BIN/hv_jpx_merge"
    split="$HVJP2K_BIN/hv_jpx_split"
else
    merge=hv_jpx_merge
    split=hv_jpx_split
fi
python=${HVJP2K_PYTHON:-python3}

for name in aia swap hetero; do
    mkdir "$work_root/$name-test"
    cd "$work_root/$name-test"

    "$merge" -i "$test_dir/$name-ref"/*.jp2 -o "$name-hv.jpx"
    "$merge" -i "$test_dir/$name-ref"/*.jp2 -o "$name-hv-links.jpx" -links

    "$python" "$test_dir/validate.py" embedded "$name-hv.jpx" \
        "$test_dir/$name-ref"/*.jp2
    "$python" "$test_dir/validate.py" linked "$name-hv-links.jpx" \
        "$test_dir/$name-ref"/*.jp2

    mkdir roundtrip
    cd roundtrip
    "$split" -i ../"$name-hv.jpx"
    for output in ./*.jp2; do
        cmp "$output" "$test_dir/$name-ref/$(basename "$output")"
    done
    echo "pass: $name"
done

mkdir "$work_root/linked input"
cp "$test_dir/aia-ref/000.jp2" "$work_root/linked input/a #1.jp2"
cd "$work_root"
"$merge" -i "linked input/a #1.jp2" -o escaped-link.jpx -links
"$python" "$test_dir/validate.py" linked escaped-link.jpx "linked input/a #1.jp2"
echo "pass: escaped link"

mkdir "$work_root/invalid"
dd if="$test_dir/aia-ref/000.jp2" of="$work_root/invalid/no-signature.jp2" \
    bs=1 skip=12 2>/dev/null
if "$merge" -i "$work_root/invalid/no-signature.jp2" \
    -o "$work_root/invalid/no-signature.jpx" 2>/dev/null; then
    echo "fail: accepted JP2 without signature box" >&2
    exit 1
fi
echo "pass: reject JP2 without signature box"
