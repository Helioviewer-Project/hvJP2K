#!/bin/sh

set -eu

test_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
work_root=$(mktemp -d "${TMPDIR:-/tmp}/hvjp2k-jpx-test.XXXXXX")
trap 'rm -rf "$work_root"' EXIT

if [ -n "${HVJP2K_BIN:-}" ]; then
    merge="$HVJP2K_BIN/hv_jpx_merge"
    split="$HVJP2K_BIN/hv_jpx_split"
else
    merge=hv_jpx_merge
    split=hv_jpx_split
fi

for name in aia swap hetero; do
    cp -R "$test_dir/$name-ref" "$work_root/$name-ref"
    cp "$test_dir/$name.jpx" "$work_root/$name.jpx"
    mkdir "$work_root/$name-test"
    cd "$work_root/$name-test"

    "$split" -i "../$name.jpx"
    "$merge" -i ./*.jp2 -o "$name-hv.jpx"
    "$merge" -i ../"$name-ref"/*.jp2 -o "$name-hv-links.jpx" -links

    for output in ./*; do
        cmp "$output" "../$name-ref/$(basename "$output")"
    done
    echo "pass: $name"
done
