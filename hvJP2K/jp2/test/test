#!/bin/sh

set -eu

test_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/hvjp2k-jp2-test.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT

if [ -n "${HVJP2K_BIN:-}" ]; then
    decode="$HVJP2K_BIN/hv_jp2_decode"
    encode="$HVJP2K_BIN/hv_jp2_encode"
    verify="$HVJP2K_BIN/hv_jp2_verify"
else
    decode=hv_jp2_decode
    encode=hv_jp2_encode
    verify=hv_jp2_verify
fi
python=${HVJP2K_PYTHON:-python3}

printf '%s\n' '<html><title>503 Service Unavailable</title></html>' > "$work_dir/http-error.jp2"
: > "$work_dir/empty.jp2"
printf '\000\000\000\014jP  ' > "$work_dir/truncated.jp2"
for name in http-error empty truncated; do
    input="$work_dir/$name.jp2"
    # Non-JP2 input must fail before attempting to load this missing schema.
    if "$verify" -v -i "$input" -schema "$work_dir/missing.sch" \
        > "$work_dir/verify.stdout" 2> "$work_dir/verify.stderr"; then
        echo "verifier accepted non-JP2 input: $input" >&2
        exit 1
    fi
    test ! -s "$work_dir/verify.stdout"
    test "$(cat "$work_dir/verify.stderr")" = "$input: not a JP2 file (invalid signature)"
done
echo "pass: reject non-JP2 inputs"

"$python" "$test_dir/encode.py" "$encode" "$verify"

name=2010_04_01__00_00_28__PROBA2_SWAP_SWAP_174
"$decode" -no_decode -record "$work_dir/record" -i "$test_dir/$name.jp2"
test "$(cat "$work_dir/record")" = 'Clevels=5'
"$decode" -i "$test_dir/$name.jp2" -o "$work_dir/$name.ppm" \
    -region '{0.6,0.1},{0.3,0.5}' -reduce 2 --threads 2
cmp "$work_dir/$name.ppm" "$test_dir/$name.ppm"
echo "pass: $name.jp2"

"$test_dir/transcode/test"
