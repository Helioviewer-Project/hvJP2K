#!/bin/sh

set -eu

test_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/hvjp2k-jp2-test.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT

if [ -n "${HVJP2K_BIN:-}" ]; then
    decode="$HVJP2K_BIN/hv_jp2_decode"
    encode="$HVJP2K_BIN/hv_jp2_encode"
    verify="$HVJP2K_BIN/hv_jp2_verify"
else
    decode=hv_jp2_decode
    encode=hv_jp2_encode
    verify=hv_jp2_verify
fi
python=${HVJP2K_PYTHON:-python3}

"$python" "$test_dir/encode.py" "$encode" "$verify"

name=2010_04_01__00_00_28__PROBA2_SWAP_SWAP_174
"$decode" -no_decode -record "$work_dir/record" -i "$test_dir/$name.jp2"
test "$(cat "$work_dir/record")" = 'Clevels=5'
"$decode" -i "$test_dir/$name.jp2" -o "$work_dir/$name.ppm" \
    -region '{0.6,0.1},{0.3,0.5}' -reduce 2 --threads 2
cmp "$work_dir/$name.ppm" "$test_dir/$name.ppm"
echo "pass: $name.jp2"
